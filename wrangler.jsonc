{
  // Static assets in ./public plus a small Worker (src/index.js) for /api/config.
  // Workers Builds runs `npx wrangler deploy` on each push; no build step needed.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "somatic-pause",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Question bank. Seeded from src/questions.json the first time it's read.
  "kv_namespaces": [
    { "binding": "QUESTIONS", "id": "7fd55acae5db466cad81c39e2cc9c5e8" }
  ],
  // QUESTION_SECONDS is set in the dashboard, not here. keep_vars stops each
  // deploy from wiping it. The code defaults to 6 when it isn't set.
  "keep_vars": true
}
